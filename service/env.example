# Copy to a user-only file such as ~/.config/dingding-me-agent/env (chmod 600).
# DWS must be available in PATH and already authenticated separately.
DINGDING_ME_AGENT_HOME=/ABS/PATH/TO/state
DINGDING_ME_AGENT_DWS_BIN=/ABS/PATH/TO/dws
DINGDING_ME_AGENT_AI_API_KEY=REPLACE_AT_RUNTIME
DINGDING_ME_AGENT_AI_MODEL=REPLACE_AT_RUNTIME
DINGDING_ME_AGENT_AI_BASE_URL=https://api.openai.com/v1
